{
  "name": "afreen-mall-software",
  "productName": "Afreen Mall Software",
  "version": "1.0.0",
  "description": "Afreen Mall — Enterprise Operations Desktop Software",
  "author": "Afreen Mall Enterprises",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run desktop:compile\" \"wait-on http://localhost:3000 && electron dist-electron/main.js\"",
    "build": "vite build && npm run desktop:compile",
    "desktop:compile": "tsc -p electron/tsconfig.json",
    "start": "npm run desktop:compile && electron dist-electron/main.js",
    "pack": "npm run build && electron-builder --dir",
    "make:exe": "npm run build && electron-builder --win",
    "desktop:build": "npm run make:exe"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "lucide-react": "^0.330.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^9.1.0"
  }
}
