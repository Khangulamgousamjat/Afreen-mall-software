{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.afreenmall.software",
  "productName": "Afreen Mall Software",
  "copyright": "Copyright © 2026 Afreen Mall Enterprises",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**/*",
    "apps/web/dist/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Afreen Mall Software",
    "uninstallDisplayName": "Afreen Mall Software"
  }
}
