{
  "name": "@afreen-mall/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p ../../packages/shared-types/tsconfig.json && prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "start:render": "npx prisma db push --accept-data-loss && node dist/index.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@afreen-mall/shared-types": "*",
    "@prisma/client": "^5.10.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/pdfkit": "^0.13.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.1",
    "vitest": "^2.0.0"
  }
}
