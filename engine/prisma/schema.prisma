datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_ADMIN
  BRANCH_ADMIN
  REGIONAL_MANAGER
  STORE_MANAGER
  PURCHASE_MANAGER
  INVENTORY_MANAGER
  FINANCE_MANAGER
  HR_MANAGER
  SALES_MANAGER
  CRM_MANAGER
  ACCOUNTANT
  CASHIER
  CASH_OFFICER
  INVENTORY_STAFF
  WAREHOUSE_STAFF
  PURCHASE_TEAM
  CUSTOMER_SERVICE
  AUDITOR
  READ_ONLY
}

enum SaleType {
  RETAIL
  WHOLESALE
  INSTITUTIONAL
}

enum PaymentMode {
  CASH
  CARD
  UPI
  SPLIT
}

enum CashVarianceStatus {
  MATCHED
  SHORT
  EXCESS
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

// Identity & Access
model User {
  id                 String     @id @default(uuid())
  staffId            Int        @unique // Auto-incrementing sequence starting 300000
  username           String     @unique
  fullName           String
  passwordHash       String
  role               RoleName
  mustChangePassword Boolean    @default(true)
  isLocked           Boolean    @default(false)
  failedAttempts     Int        @default(0)
  lockoutUntil       DateTime?
  lastLoginAt        DateTime?
  isDeactivated      Boolean    @default(false)
  canProcessSaleReturn Boolean  @default(false)
  sessions           Session[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  staffId   Int?
  username  String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  staffId     Int
  userName    String
  userRole    String
  action      String
  entityName  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  reason      String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

// Store & System
model Store {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @default("Afreen Mall")
  address   String
  phone     String
  email     String
  gstin     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Catalog
model Category {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  subCategories SubCategory[]
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
}

model SubCategory {
  id         String    @id @default(uuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  name       String
  code       String    @unique
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Unit {
  id        String    @id @default(uuid())
  name      String    @unique // Pcs, Kg, Ltr, Pack
  code      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model TaxRate {
  id        String    @id @default(uuid())
  name      String    // GST 5%, GST 12%, GST 18%
  rate      Float     // 5, 12, 18
  products  Product[]
  createdAt DateTime  @default(now())
}

model HSNCode {
  id          String    @id @default(uuid())
  code        String    @unique
  description String
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String       @id @default(uuid())
  barcode       String       @unique
  name          String
  description   String
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  brandId       String?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id])
  taxRateId     String
  taxRate       TaxRate      @relation(fields: [taxRateId], references: [id])
  hsnCodeId     String?
  hsnCode       HSNCode?     @relation(fields: [hsnCodeId], references: [id])
  mrp           Int          // Paise
  saleRate      Int          // Paise
  discountPct   Float        @default(0)
  minStockLevel Int          @default(10)
  inventory     Inventory?
  saleItems     SaleItem[]
  poLineItems   POLineItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
}

// Inventory
model Inventory {
  id            String          @id @default(uuid())
  productId     String          @unique
  product       Product         @relation(fields: [productId], references: [id])
  currentStock  Int             @default(0)
  reservedStock Int             @default(0)
  movements     StockMovement[]
  adjustments   StockAdjustment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model StockMovement {
  id          String   @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  type        String   // SALE, RETURN, PURCHASE_GRN, ADJUSTMENT, TRANSFER
  quantity    Int      // positive for addition, negative for deduction
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())
}

model StockAdjustment {
  id          String   @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  oldStock    Int
  newStock    Int
  difference  Int
  reason      String
  performedBy String
  createdAt   DateTime @default(now())
}

// POS & Sales
model Register {
  id            String          @id @default(uuid())
  posNumber     String          @unique // POS-01, POS-02
  name          String
  isActive      Boolean         @default(true)
  sales         Sale[]
  closes        RegisterClose[]
  cashReports   ManagerCashReport[]
  createdAt     DateTime        @default(now())
}

model Sale {
  id              String      @id @default(uuid())
  invoiceNo       String      @unique
  registerId      String
  register        Register    @relation(fields: [registerId], references: [id])
  saleType        SaleType    @default(RETAIL)
  cashierStaffId  Int
  cashierName     String
  paymentMode     PaymentMode
  totalQty        Int
  totalDiscount   Int         // Paise
  totalAmount     Int         // Paise
  paidCash        Int         @default(0) // Paise
  paidCard        Int         @default(0) // Paise
  paidUPI         Int         @default(0) // Paise
  changeDue       Int         @default(0) // Paise
  customerPhone   String?
  customerName    String?
  transactionId   String?
  isManuallyRecovered Boolean @default(false)
  recoveredByStaffId Int?
  recoveredAt     DateTime?
  reprintCount    Int         @default(0)
  status          String      @default("COMPLETED") // COMPLETED, CANCELLED, RETURNED
  items           SaleItem[]
  saleReturns     SaleReturn[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  qty         Int
  mrp         Int      // Paise
  rate        Int      // Paise
  discountPct Float    @default(0)
  discountAmt Int      @default(0) // Paise
  gstPct      Float    @default(0)
  netRate     Int      // Paise
  totalValue  Int      // Paise
}

model SaleReturn {
  id            String   @id @default(uuid())
  returnNo      String   @unique
  originalSaleId String
  originalSale  Sale     @relation(fields: [originalSaleId], references: [id])
  cashierStaffId Int
  cashierName   String
  refundMode    PaymentMode
  totalAmount   Int      // Paise
  reason        String
  createdAt     DateTime @default(now())
}

// Cash Reconciliation Pipeline
model RegisterClose {
  id             String   @id @default(uuid())
  registerId     String
  register       Register @relation(fields: [registerId], references: [id])
  date           String   // YYYY-MM-DD
  cashierStaffId Int
  cashierName    String
  systemCash     Int      // Paise
  systemCard     Int      // Paise
  systemUPI      Int      // Paise
  countedCash    Int      // Paise
  denominations  Json     // { d2000, d500, d200... }
  useBNACount    Boolean  @default(false)
  bnaDepositAmount Int?   // Paise
  bnaSlipNumber  String?
  variance       Int      // Paise
  status         CashVarianceStatus
  isCloseReturn  Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ManagerCashReport {
  id                  String   @id @default(uuid())
  date                String   // YYYY-MM-DD
  registerId          String
  register            Register @relation(fields: [registerId], references: [id])
  posNumber           String
  cashOfficerStaffId Int
  cashOfficerName     String
  managerStaffId      Int
  managerName         String
  denominations       Json     // Note count breakdown
  cashTotal           Int      // Paise
  upiTotal            Int      // Paise
  cardTotal           Int      // Paise
  bnaReportedAmount   Int      // Paise
  systemTotalSales    Int      // Paise
  finalVariance       Int      // Paise
  varianceStatus      CashVarianceStatus
  accountantApproved  Boolean  @default(false)
  accountantApprovedBy String?
  accountantApprovedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Purchasing
model Supplier {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String
  phone         String
  email         String
  address       String
  gstin         String
  purchaseOrders PurchaseOrder[]
  createdAt     DateTime @default(now())
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Int                 // Paise
  lineItems   POLineItem[]
  grns        GRN[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model POLineItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  orderedQty      Int
  unitCost        Int           // Paise
  totalCost       Int           // Paise
}

model GRN {
  id              String        @id @default(uuid())
  grnNumber       String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedBy      String
  receivedDate    DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
}

// Warehouse
model Warehouse {
  id        String   @id @default(uuid())
  name      String   @default("Main Warehouse")
  code      String   @unique
  racks     Rack[]
  createdAt DateTime @default(now())
}

model Rack {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  rackNumber  String
  bins        Bin[]
  createdAt   DateTime  @default(now())
}

model Bin {
  id        String   @id @default(uuid())
  rackId    String
  rack      Rack     @relation(fields: [rackId], references: [id])
  binCode   String   @unique
  capacity  Int
  createdAt DateTime @default(now())
}

// Customers (Loyalty Records Only - No Authentication)
model Customer {
  id            String   @id @default(uuid())
  phone         String   @unique
  fullName      String
  email         String?
  tier          String   @default("SILVER") // BRONZE, SILVER, GOLD, PLATINUM
  loyaltyPoints Int      @default(0)
  lastVisit     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Accounting Models
model Account {
  id                   String        @id @default(uuid())
  accountCode          String        @unique
  accountName          String
  category             String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  type                 String        // DEBIT, CREDIT
  balance              Int           @default(0) // Paise
  journalLines         JournalLine[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model JournalEntry {
  id          String        @id @default(uuid())
  journalNo   String        @unique
  date        DateTime      @default(now())
  description String
  postedBy    String
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Int          @default(0) // Paise
  credit         Int          @default(0) // Paise
  createdAt      DateTime     @default(now())
}

// HRMS Models
model Employee {
  id              String   @id @default(uuid())
  empCode         String   @unique
  fullName        String
  department      String
  branch          String   @default("Main Branch")
  role            String   @default("CASHIER")
  employmentType  String   @default("FULL_TIME")
  pan             String?
  aadhaar         String?
  bankName        String?
  bankAccountNo   String?
  isDeactivated   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AttendanceLog {
  id         String   @id @default(uuid())
  punchNo    String   @unique
  empCode    String
  punchType  String   // CHECK_IN, CHECK_OUT
  deviceId   String
  remarks    String?
  punchTime  DateTime @default(now())
  createdAt  DateTime @default(now())
}

model LeaveApplication {
  id        String   @id @default(uuid())
  leaveNo   String   @unique
  empCode   String
  leaveType String
  startDate String
  endDate   String
  reason    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

model PayrollBatch {
  id          String    @id @default(uuid())
  batchNo     String    @unique
  monthYear   String    // YYYY-MM
  remarks     String?
  totalAmount Int       @default(0) // Paise
  status      String    @default("COMPLETED")
  payslips    Payslip[]
  createdAt   DateTime  @default(now())
}

model Payslip {
  id             String       @id @default(uuid())
  payrollBatchId String
  payrollBatch   PayrollBatch @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  empCode        String
  employeeName   String
  netPayable     Int          // Paise
  createdAt      DateTime     @default(now())
}

// Sales Quotes & Orders
model Quotation {
  id           String   @id @default(uuid())
  quotationNo  String   @unique
  customerName String
  contactPhone String?
  validUntil   String
  totalAmount  Int      // Paise
  status       String   @default("ISSUED") // DRAFT, ISSUED, ACCEPTED, EXPIRED
  items        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalesOrder {
  id               String   @id @default(uuid())
  orderNo          String   @unique
  customerName     String
  paymentTerms     String
  expectedDelivery String
  totalAmount      Int      // Paise
  status           String   @default("CONFIRMED") // CONFIRMED, DISPATCHED, DELIVERED, CANCELLED
  items            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Supplier Contracts & Payments
model VendorContract {
  id            String   @id @default(uuid())
  contractNo    String   @unique
  supplierName  String
  contractTitle String
  startDate     String
  endDate       String
  slaDays       Int      @default(2)
  notes         String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupplierPayment {
  id           String   @id @default(uuid())
  receiptNo    String   @unique
  supplierName String
  amount       Int      // Paise
  paymentMode  String
  referenceNo  String
  notes        String?
  createdAt    DateTime @default(now())
}

// Admin Platform Settings Models
model Company {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  taxId         String?
  financialYear String   @default("2026-27")
  currency      String   @default("INR")
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
}

model Branch {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  city         String?
  gstin        String?
  contactPhone String?
  createdAt    DateTime @default(now())
}

model NumberSeries {
  id         String   @id @default(uuid())
  module     String   @unique
  prefix     String
  currentSeq Int      @default(1)
  padding    Int      @default(6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ApprovalRule {
  id            String   @id @default(uuid())
  module        String
  minAmount     Int      // Paise
  maxAmount     Int      // Paise
  requiredRoles Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Workflow {
  id        String   @id @default(uuid())
  name      String
  trigger   String
  steps     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  key       String    @unique
  role      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model Backup {
  id        String   @id @default(uuid())
  filename  String
  sizeBytes Int
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
}

model SchedulerJob {
  id        String    @id @default(uuid())
  name      String
  module    String
  action    String
  cron      String
  cronDesc  String?
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}

model MaintenanceState {
  id        String   @id @default(uuid())
  enabled   Boolean  @default(false)
  reason    String?
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id          String   @id @default(uuid())
  roleName    String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeldBill {
  id               String   @id @default(uuid())
  holdNo           String   @unique
  registerId       String?
  registerName     String?
  cashierName      String
  customerPhone    String?
  customerName     String?
  note             String?
  totalAmountPaise Int
  cartJson         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

